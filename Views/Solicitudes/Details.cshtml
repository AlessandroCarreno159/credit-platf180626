@model credit_platf.Models.SolicitudCredito
@using credit_platf.Services
@{
    ViewData["Title"] = $"Solicitud #{Model.Id}";
    var esAprobable = SolicitudReglas.EsAprobable(Model.MontoSolicitado, Model.Cliente?.IngresosMensuales ?? 0);
    var tope = SolicitudReglas.MultiploMaximoAprobacion * (Model.Cliente?.IngresosMensuales ?? 0);
}

<h1>Solicitud <span class="text-muted">#@Model.Id</span></h1>

@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success">@exito</div>
}

<div class="card mt-3" data-solicitud-row="@Model.Id">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Cliente</dt>
            <dd class="col-sm-9">@(Model.Cliente?.Usuario?.Email ?? "(sin usuario)")</dd>

            <dt class="col-sm-3">Ingresos mensuales</dt>
            <dd class="col-sm-9">@((Model.Cliente?.IngresosMensuales ?? 0).ToString("C"))</dd>

            <dt class="col-sm-3">Monto solicitado</dt>
            <dd class="col-sm-9 fw-bold">@Model.MontoSolicitado.ToString("C")</dd>

            <dt class="col-sm-3">Fecha de solicitud (UTC)</dt>
            <dd class="col-sm-9">@Model.FechaSolicitud.ToString("yyyy-MM-dd HH:mm")</dd>

            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9" data-estado-celda data-estado-valor="@Model.Estado">
                @if (Model.Estado == credit_platf.Models.EstadoSolicitud.Pendiente)
                { <span class="badge bg-warning text-dark">Pendiente</span> }
                else if (Model.Estado == credit_platf.Models.EstadoSolicitud.Aprobado)
                { <span class="badge bg-success">Aprobado</span> }
                else
                { <span class="badge bg-danger">Rechazado</span> }
            </dd>

            @if (Model.Estado == credit_platf.Models.EstadoSolicitud.Rechazado)
            {
                <dt class="col-sm-3">Motivo de rechazo</dt>
                <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.MotivoRechazo) ? "(sin motivo registrado)" : Model.MotivoRechazo)</dd>
            }

            <dt class="col-sm-3">Tope de aprobación (5×)</dt>
            <dd class="col-sm-9">
                @tope.ToString("C")
                @if (esAprobable) { <span class="badge bg-success ms-2">Aprobable</span> }
                else { <span class="badge bg-danger ms-2">No aprobable (&gt;5×)</span> }
            </dd>
        </dl>
    </div>
</div>

<div class="mt-3 d-flex gap-2">
    <a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
</div>

<partial name="_TiempoReal" model="new List<int> { Model.Id }" />
